# Copy to .env for local tooling only. QualityProof never writes this file.
# Future integrations may define credential variable names here.
QUALITYPROOF_DATABASE_PATH=.qualityproof/qualityproof.db
QUALITYPROOF_SCHEMA_DIRECTORY=.qualityproof/schemas

# Control service is read-only and local by default.
QUALITYPROOF_PROJECT_DIRECTORY=.
QUALITYPROOF_BENCHMARK_DIRECTORY=benchmark-results
QUALITYPROOF_RUN_QUEUE_DIRECTORY=.qualityproof/run-queue
QUALITYPROOF_RUN_SUBMISSION_ENABLED=false
QUALITYPROOF_API_TOKEN=
QUALITYPROOF_REPORT_ACCESS_ENABLED=false
QUALITYPROOF_REPORT_TOKEN=

# Optional integration placeholder; leave empty until configured.
QUALITYPROOF_JIRA_BEARER_TOKEN=
